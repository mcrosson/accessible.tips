{{- $icons := slice
    (dict "src" "/android-chrome-192x192.png" "sizes" "192x192" "type" "image/png" "purpose" "any")
    (dict "src" "/android-chrome-512x512.png" "sizes" "512x512" "type" "image/png" "purpose" "any")
    (dict "src" "/android-chrome-192x192-maskable.png" "sizes" "192x192" "type" "image/png" "purpose" "maskable")
    (dict "src" "/android-chrome-512x512-maskable.png" "sizes" "512x512" "type" "image/png" "purpose" "maskable")
-}}
{{- dict
    "name" site.Title
    "short_name" site.Title
    "description" site.Params.description
    "start_url" "/"
    "scope" "/"
    "id" "/"
    "lang" site.LanguageCode
    "display" "standalone"
    "theme_color" "#ffffff"
    "background_color" "#ffffff"
    "icons" $icons
  | jsonify -}}
