{{- /*
  index.searchvocab.json — corrector vocabulary asset (accessible.tips).

  Build-time vocabulary for the typo corrector. Iterates site.RegularPages
  (excluding drafts), tokenizes title + .Plain + tags + search_terms + the
  page's equiv-injection set (M9 — so searchable synonyms/misspellings that
  live only in frontmatter or the hidden injection are IN-vocabulary and never
  treated as unknown typos), drops stopwords and short tokens, and accumulates
  document frequencies. The injection set comes from the SHARED
  equiv-page-inject.html partial — same computation the templates render.
*/ -}}
{{- $pages := where site.RegularPages "Draft" false -}}
{{- $sc := newScratch -}}
{{- $stop := dict -}}
{{- range site.Data.search.stopwords -}}
  {{- $stop = merge $stop (dict . true) -}}
{{- end -}}
{{- range $page := $pages -}}
  {{- $seen := dict -}}
  {{- $chunks := slice $page.Title $page.Plain -}}
  {{- range $tag := $page.Params.tags -}}
    {{- $chunks = $chunks | append (printf "%v" $tag) -}}
  {{- end -}}
  {{- range $term := $page.Params.search_terms -}}
    {{- $chunks = $chunks | append (printf "%v" $term) -}}
  {{- end -}}
  {{- range $member := partial "equiv-page-inject.html" $page -}}
    {{- $chunks = $chunks | append (printf "%v" $member) -}}
  {{- end -}}
  {{- range $chunk := $chunks -}}
    {{- $t := lower $chunk -}}
    {{- $t = replaceRE `[^a-z0-9]+` " " $t -}}
    {{- range $w := split $t " " -}}
      {{- if and (gt (len $w) 2) (not (index $stop $w)) -}}
        {{- $seen = merge $seen (dict $w true) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- range $w, $v := $seen -}}
    {{- $cur := int (or (index ($sc.Get "df") $w) 0) -}}
    {{- $sc.SetInMap "df" $w (add $cur 1) -}}
  {{- end -}}
{{- end -}}
{{- dict "df" ($sc.Get "df") | jsonify (dict "indent" "") -}}
