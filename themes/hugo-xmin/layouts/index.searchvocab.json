{{- /*
  index.searchvocab.json — corrector vocabulary asset (accessible.tips).

  Build-time vocabulary for the typo corrector. Iterates site.RegularPages
  (excluding drafts), tokenizes title + .Plain + tags, drops stopwords and
  short tokens, and accumulates document frequencies.

  Compared to culinary's source: this drops the equivalence normalization
  (equiv_lists.toml, equiv-singular.html, equiv-page-termset.html). The
  corrector's vocabulary is built fresh from raw tokens.
*/ -}}
{{- $pages := where site.RegularPages "Draft" false -}}
{{- $sc := newScratch -}}
{{- $stop := dict "the" true "a" true "an" true "and" true "or" true "but" true
  "is" true "are" true "was" true "were" true "be" true "been" true "being" true
  "have" true "has" true "had" true "do" true "does" true "did" true
  "will" true "would" true "could" true "should" true "may" true "might" true
  "must" true "shall" true "can" true "of" true "in" true "on" true "at" true
  "to" true "for" true "with" true "from" true "by" true "as" true "into" true
  "through" true "during" true "before" true "after" true "above" true "below" true
  "between" true "out" true "off" true "over" true "under" true "again" true
  "further" true "then" true "once" true "here" true "there" true "when" true
  "where" true "why" true "how" true "all" true "any" true "both" true "each" true
  "few" true "more" true "most" true "other" true "some" true "such" true "no" true
  "nor" true "not" true "only" true "own" true "same" true "so" true "than" true
  "too" true "very" true "i" true "you" true "your" true "this" true "that" true
  "it" true "his" true "her" true "their" true "they" true "we" true "our" true
  "my" true "me" true "what" true "which" true "who" true "whom" true -}}
{{- range $page := $pages -}}
  {{- $seen := dict -}}
  {{- $chunks := slice $page.Title $page.Plain -}}
  {{- range $tag := $page.Params.tags -}}
    {{- $chunks = $chunks | append (printf "%v" $tag) -}}
  {{- end -}}
  {{- range $chunk := $chunks -}}
    {{- $t := lower $chunk -}}
    {{- $t = replaceRE `[^a-z0-9]+` " " $t -}}
    {{- range $w := split $t " " -}}
      {{- if and (gt (len $w) 2) (not (index $stop $w)) -}}
        {{- $seen = merge $seen (dict $w true) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- range $w, $v := $seen -}}
    {{- $cur := int (or (index ($sc.Get "df") $w) 0) -}}
    {{- $sc.SetInMap "df" $w (add $cur 1) -}}
  {{- end -}}
{{- end -}}
{{- dict "df" ($sc.Get "df") | jsonify (dict "indent" "") -}}
